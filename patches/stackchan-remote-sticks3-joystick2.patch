+@echo off
+setlocal
+
+set "SCRIPT_DIR=%~dp0"
+set "OUTPUT=%SCRIPT_DIR%..\..\..\StackChan-RemoteControl-StickS3-Joystick2_0x0.bin"
+set "SKIP_BUILD=0"
+
+if not "%~1"=="" (
+    if /I "%~1"=="--skip-build" (
+        set "SKIP_BUILD=1"
+    ) else (
+        set "OUTPUT=%~1"
+    )
+)
+
+cd /d "%SCRIPT_DIR%"
+
+if not exist "sdkconfig.defaults" (
+    echo sdkconfig.defaults is missing from %SCRIPT_DIR%
+    exit /b 1
+)
+
+if not exist "partitions_sticks3.csv" (
+    echo partitions_sticks3.csv is missing from %SCRIPT_DIR%
+    exit /b 1
+)
+
+where idf.py >nul 2>nul
+if errorlevel 1 (
+    if "%IDF_PATH%"=="" (
+        echo idf.py was not found. Run this from an ESP-IDF Command Prompt.
+        exit /b 1
+    )
+    if not exist "%IDF_PATH%\tools\idf.py" (
+        echo %IDF_PATH%\tools\idf.py was not found.
+        exit /b 1
+    )
+    set "IDF_CMD=python"
+    set "IDF_SCRIPT=%IDF_PATH%\tools\idf.py"
+) else (
+    set "IDF_CMD=idf.py"
+    set "IDF_SCRIPT="
+)
+
+if "%SKIP_BUILD%"=="0" (
+    if exist "build\config\sdkconfig.cmake" del "build\config\sdkconfig.cmake"
+    if exist "build\config\sdkconfig.h" del "build\config\sdkconfig.h"
+    if exist "build\partition_table\partition-table.bin" del "build\partition_table\partition-table.bin"
+
+    echo.
+    echo ^>^> Reconfigure for esp32s3 with sdkconfig.defaults
+    if defined IDF_SCRIPT (
+        %IDF_CMD% "%IDF_SCRIPT%" -D IDF_TARGET=esp32s3 -D SDKCONFIG_DEFAULTS=sdkconfig.defaults reconfigure
+    ) else (
+        %IDF_CMD% -D IDF_TARGET=esp32s3 -D SDKCONFIG_DEFAULTS=sdkconfig.defaults reconfigure
+    )
+    if errorlevel 1 exit /b %errorlevel%
+
+    echo.
+    echo ^>^> Build firmware
+    if defined IDF_SCRIPT (
+        %IDF_CMD% "%IDF_SCRIPT%" build
+    ) else (
+        %IDF_CMD% build
+    )
+    if errorlevel 1 exit /b %errorlevel%
+)
+
+if not exist "build\flash_args" (
+    echo build\flash_args was not generated. Build the firmware first or run without --skip-build.
+    exit /b 1
+)
+
+echo.
+echo ^>^> Merge M5Burner image
+cd /d "%SCRIPT_DIR%build"
+python -m esptool --chip esp32s3 merge_bin -o "%OUTPUT%" @flash_args
+if errorlevel 1 exit /b %errorlevel%
+
+echo.
+echo Created M5Burner image:
+echo %OUTPUT%
+endlocal
diff --git a/remote/code/package_sticks3_m5burner.ps1 b/remote/code/package_sticks3_m5burner.ps1
new file mode 100644
index 0000000..d76a445
--- /dev/null
+++ b/remote/code/package_sticks3_m5burner.ps1
@@ -0,0 +1,92 @@
+param(
+    [string]$Output = "..\..\..\StackChan-RemoteControl-StickS3-Joystick2_0x0.bin",
+    [switch]$SkipBuild
+)
+
+$ErrorActionPreference = "Stop"
+
+function Invoke-Step {
+    param(
+        [string]$Title,
+        [scriptblock]$Command
+    )
+
+    Write-Host ""
+    Write-Host "==> $Title"
+    & $Command
+    if ($LASTEXITCODE -ne 0) {
+        throw "$Title failed with exit code $LASTEXITCODE"
+    }
+}
+
+Set-Location $PSScriptRoot
+
+foreach ($requiredFile in @("sdkconfig.defaults", "partitions_sticks3.csv")) {
+    if (-not (Test-Path (Join-Path $PSScriptRoot $requiredFile))) {
+        throw "$requiredFile is missing from $PSScriptRoot"
+    }
+}
+
+$idfCommand = Get-Command idf.py -ErrorAction SilentlyContinue
+if ($idfCommand) {
+    $idfExe = "idf.py"
+    $idfPrefixArgs = @()
+}
+elseif ($env:IDF_PATH -and (Test-Path (Join-Path $env:IDF_PATH "tools\idf.py"))) {
+    $idfExe = "python"
+    $idfPrefixArgs = @((Join-Path $env:IDF_PATH "tools\idf.py"))
+}
+else {
+    throw "idf.py was not found. Run this from an ESP-IDF PowerShell/Command Prompt."
+}
+
+function Invoke-Idf {
+    param([Parameter(ValueFromRemainingArguments = $true)][string[]]$Arguments)
+    & $idfExe @idfPrefixArgs @Arguments
+}
+
+if (-not $SkipBuild) {
+    foreach ($cacheFile in @(
+        "build\config\sdkconfig.cmake",
+        "build\config\sdkconfig.h",
+        "build\partition_table\partition-table.bin"
+    )) {
+        $cachePath = Join-Path $PSScriptRoot $cacheFile
+        if (Test-Path $cachePath) {
+            Remove-Item $cachePath
+        }
+    }
+
+    Invoke-Step "Reconfigure for esp32s3 with sdkconfig.defaults" {
+        Invoke-Idf -D IDF_TARGET=esp32s3 -D SDKCONFIG_DEFAULTS=sdkconfig.defaults reconfigure
+    }
+
+    Invoke-Step "Build firmware" {
+        Invoke-Idf build
+    }
+}
+
+$flashArgs = Join-Path $PSScriptRoot "build\flash_args"
+if (-not (Test-Path $flashArgs)) {
+    throw "build\flash_args was not generated. Build the firmware first or run without -SkipBuild."
+}
+
+$outputPath = $ExecutionContext.SessionState.Path.GetUnresolvedProviderPathFromPSPath($Output)
+$outputDir = Split-Path -Parent $outputPath
+if (-not (Test-Path $outputDir)) {
+    New-Item -ItemType Directory -Path $outputDir | Out-Null
+}
+
+Push-Location (Join-Path $PSScriptRoot "build")
+try {
+    Invoke-Step "Merge M5Burner image" {
+        python -m esptool --chip esp32s3 merge_bin -o $outputPath "@flash_args"
+    }
+}
+finally {
+    Pop-Location
+}
+
+Write-Host ""
+Write-Host "Created M5Burner image:"
+Write-Host $outputPath

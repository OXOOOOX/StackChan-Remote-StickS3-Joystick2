diff --git a/remote/code/main/stick_s3_display.cpp b/remote/code/main/stick_s3_display.cpp
new file mode 100644
index 0000000..0f094cc
--- /dev/null
+++ b/remote/code/main/stick_s3_display.cpp
@@ -0,0 +1,58 @@
+#include "stick_s3_display.h"
+
+#include <M5Unified.h>
+#include "lgfx/v1/panel/Panel_ST7789.hpp"
+
+extern "C" bool stick_s3_display_init(void)
+{
+    if (M5.Display.width() > 0 && M5.Display.height() > 0) {
+        return true;
+    }
+
+    auto bus = new lgfx::Bus_SPI();
+    auto bus_cfg = bus->config();
+    bus_cfg.spi_host = SPI2_HOST;
+    bus_cfg.freq_write = 40000000;
+    bus_cfg.freq_read = 15000000;
+    bus_cfg.pin_mosi = GPIO_NUM_39;
+    bus_cfg.pin_miso = GPIO_NUM_NC;
+    bus_cfg.pin_sclk = GPIO_NUM_40;
+    bus_cfg.pin_dc = GPIO_NUM_45;
+    bus_cfg.spi_3wire = true;
+    bus->config(bus_cfg);
+
+    auto panel = new lgfx::Panel_ST7789();
+    auto panel_cfg = panel->config();
+    panel_cfg.pin_cs = GPIO_NUM_41;
+    panel_cfg.pin_rst = GPIO_NUM_21;
+    panel_cfg.pin_busy = GPIO_NUM_NC;
+    panel_cfg.panel_width = 135;
+    panel_cfg.panel_height = 240;
+    panel_cfg.offset_x = 52;
+    panel_cfg.offset_y = 40;
+    panel_cfg.invert = true;
+    panel->config(panel_cfg);
+    panel->setBus(bus);
+
+    auto light = new lgfx::Light_PWM();
+    auto light_cfg = light->config();
+    light_cfg.pin_bl = GPIO_NUM_38;
+    light_cfg.freq = 12000;
+    light_cfg.pwm_channel = 7;
+    light_cfg.invert = false;
+    light_cfg.offset = 0;
+    light->config(light_cfg);
+    panel->setLight(light);
+
+    bool ok = M5.Display.init(panel);
+    if (ok) {
+        M5.Display.setBrightness(180);
+        M5.Display.setRotation(1);
+        M5.Display.fillScreen(0x0000);
+        M5.Display.setTextColor(0xFFFF, 0x0000);
+        M5.Display.setCursor(4, 4);
+        M5.Display.print("StickS3 display OK");
+    }
+
+    return ok && M5.Display.width() > 0 && M5.Display.height() > 0;
+}
